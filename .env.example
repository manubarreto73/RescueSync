# ---------- App ----------
NODE_ENV=development
PORT=3000
API_PREFIX=api
SWAGGER_ENABLED=true

# ---------- PostgreSQL ----------
# Credenciales con las que docker-compose crea el contenedor de Postgres.
POSTGRES_USER=rescuesync
POSTGRES_PASSWORD=rescuesync
POSTGRES_DB=rescuesync
POSTGRES_PORT=5433

# Puerto 5433 y no 5432: esta maquina ya tiene un PostgreSQL 18 instalado
# como servicio de Windows ocupando el 5432. Se corre el contenedor al lado en
# vez de apagar esa instalacion, que puede estar en uso por otros proyectos.

# Cadena de conexion que usan Prisma y la app. Es UNA sola variable:
# Prisma no acepta host/puerto/usuario por separado.
#   - Corriendo la app fuera de Docker  -> host "localhost"
#   - Corriendo la app dentro de Docker -> host "postgres" (nombre del servicio).
#     docker-compose ya pisa esta variable con el valor correcto.
DATABASE_URL=postgresql://rescuesync:rescuesync@localhost:5433/rescuesync?schema=public

# Loguea cada query que emite Prisma (util para aprender, ruidoso en uso normal)
DB_LOGGING=false

# ---------- Redis ----------
# Puerto 6381 y no 6379: en esta maquina hay un redis-server nativo de Ubuntu
# (servicio systemd) en el 6379, y otro proyecto usando el 6380.
# Dentro de la red de Docker la API igual le habla al 6379 de su contenedor.
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=

# ---------- Seguridad / JWT ----------
# Obligatorio. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CAMBIAR_ESTE_VALOR_POR_UNO_GENERADO_DE_48_BYTES_EN_BASE64
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=7
BCRYPT_SALT_ROUNDS=10

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# ---------- Rate limiting de login (Redis) ----------
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPTS_WINDOW_MIN=5
LOGIN_BLOCK_DURATION_MIN=30
