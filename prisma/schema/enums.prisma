/// Los 4 perfiles que exige la consigna para el RBAC.
/// Prisma lo traduce a un ENUM nativo de PostgreSQL.
enum Rol {
  OPERADOR_MUNICIPAL
  CENTRO_COORDINADOR
  REPRESENTANTE_ONG
  AUDITOR
  /// Superusuario de desarrollo: pasa todos los chequeos de rol y de
  /// pertenencia. Solo lo crea el seed y se rechaza con NODE_ENV=production.
  ADMIN
}
