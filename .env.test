# Entorno de los tests e2e.
#
# Dos aislamientos respecto del entorno de desarrollo:
#   - otra base de PostgreSQL (rescuesync_test), que la suite trunca a gusto
#   - otra base de Redis (indice 1), que la suite vacia con FLUSHDB
# Asi correr los tests nunca te borra los datos con los que estabas probando.

NODE_ENV=test
PORT=3001
API_PREFIX=api
SWAGGER_ENABLED=false

DATABASE_URL=postgresql://rescuesync:rescuesync@localhost:5433/rescuesync_test?schema=public
DB_LOGGING=false

REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=
REDIS_DB=1

JWT_SECRET=secreto-solo-para-tests-no-usar-en-ningun-otro-lado-1234567890
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=7
# Cost bajo a proposito: bcrypt con cost 10 tarda ~100ms por hash y la suite
# hace decenas de logins. Con 4 baja a ~5ms sin cambiar el comportamiento.
BCRYPT_SALT_ROUNDS=4

CORS_ALLOWED_ORIGINS=http://localhost:5173

# El helper de tests lo pisa segun cada suite (ver test/helpers/test-app.ts)
THROTTLE_ENABLED=false

MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPTS_WINDOW_MIN=5
LOGIN_BLOCK_DURATION_MIN=30
